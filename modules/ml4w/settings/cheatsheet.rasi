/* ==========================================================================
   ROFI CHEATSHEET HUD - NEON GLASS
   ========================================================================== */
* {
    font:                       "JetBrainsMono Nerd Font 11";
}

configuration {
    show-icons:                 false;
    hover-select:               true;
    markup-rows:                true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

window {
    transparency:               "real";
    background-color:           rgba(10, 10, 18, 0.68);
    border:                     2.5px solid;
    border-color:               rgba(203, 166, 247, 0.9);
    border-radius:              20px;
    width:                      800px;
    padding:                    18px;
}

mainbox {
    background-color:           transparent;
    spacing:                    14px;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    background-color:           rgba(30, 30, 46, 0.7);
    border-radius:              14px;
    padding:                    10px 16px;
    border:                     1.5px solid;
    border-color:               rgba(203, 166, 247, 0.4);
    spacing:                    10px;
    children:                   [ "prompt", "entry" ];
}

prompt {
    background-color:           transparent;
    text-color:                 #f38ba8;
    font:                       "JetBrainsMono Nerd Font Bold 14";
}

entry {
    background-color:           transparent;
    text-color:                 #cdd6f4;
    border:                     0px;
    placeholder:                "Filtrar atajo...";
    placeholder-color:          rgba(205, 214, 244, 0.3);
    expand:                     true;
}

listview {
    columns:                    2;
    lines:                      13;
    spacing:                    8px;
    background-color:           transparent;
    cycle:                      true;
    dynamic:                    true;
}

element {
    padding:                    8px 12px;
    border-radius:              10px;
    background-color:           rgba(255, 255, 255, 0.04);
    text-color:                 #cdd6f4;
    border:                     1px solid;
    border-color:               rgba(255, 255, 255, 0.06);
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

/* Glow real al seleccionar: fondo + doble borde luminoso */
element selected.normal {
    background-color:           rgba(203, 166, 247, 0.25);
    border:                     1.5px solid;
    border-color:               #cba6f7;
    text-color:                 #ffffff;
}

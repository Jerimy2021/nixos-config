/* ==========================================================================
   ROFI WINDOW SWITCHER - GLASSMORPHISM COMPACT (End-4 style)
   ========================================================================== */
* {
    font:                       "JetBrainsMono Nerd Font 11";
}

configuration {
    show-icons:                 true;
    display-window:             "󰖲  Ventanas";
    window-format:              "{icon} {t}";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

window {
    transparency:               "real";
    background-color:           rgba(17, 17, 27, 0.55);
    text-color:                 #cdd6f4;
    border:                     2px solid;
    border-color:               rgba(203, 166, 247, 0.9);
    border-radius:              18px;
    width:                      620px;
    padding:                    14px;
}

mainbox {
    background-color:           transparent;
    spacing:                    10px;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    background-color:           rgba(30, 30, 46, 0.75);
    text-color:                 #cdd6f4;
    border-radius:              12px;
    padding:                    10px 14px;
    border:                     1.5px solid;
    border-color:               rgba(203, 166, 247, 0.35);
    children:                   [ "prompt", "entry" ];
}

prompt {
    background-color:           transparent;
    text-color:                 #cba6f7;
    font:                       "JetBrainsMono Nerd Font Bold 12";
    margin:                     0px 12px 0px 0px;
}

entry {
    background-color:           transparent;
    text-color:                 #cdd6f4;
    placeholder:                "Buscar ventana abierta...";
    placeholder-color:          rgba(205, 214, 244, 0.35);
    font:                       "JetBrainsMono Nerd Font 12";
}

listview {
    background-color:           transparent;
    columns:                    1;
    lines:                      8;
    spacing:                    6px;
    cycle:                      true;
    dynamic:                    true;
    layout:                     vertical;
}

element {
    background-color:           rgba(255, 255, 255, 0.03);
    text-color:                 #cdd6f4;
    border-radius:              10px;
    padding:                    8px 10px;
    border:                     0px 0px 0px 3px solid;
    border-color:               transparent;
    cursor:                     pointer;
    orientation:                horizontal;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    border-radius:              8px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    margin:                     0px 0px 0px 12px;
    font:                       "JetBrainsMono Nerd Font 11";
}

element selected.normal {
    background-color:           rgba(203, 166, 247, 0.22);
    text-color:                 #f5e0ff;
    border:                     0px 0px 0px 3px solid;
    border-color:               #cba6f7;
    border-radius:              10px;
}

element selected.normal element-text {
    text-color:                 #f5e0ff;
    font:                       "JetBrainsMono Nerd Font Bold 11";
}
